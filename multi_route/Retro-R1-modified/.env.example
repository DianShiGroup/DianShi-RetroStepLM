# Environment for the direct single-step configuration (no retrieval).
#
# Copy this file to .env, fill in the paths for your machine, and source it
# before starting the planner or the evaluation:
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a && . ./.env && set +a
#
# configs/dianshi_direct.yaml and configs/planner.yaml refer to these names
# with ${VAR}, so nothing tracked has to be edited. An unset ${VAR} without a
# ${VAR:-fallback} is left as-is on purpose, so typos show up as an explicit
# error instead of a silently empty path.

# ---------------------------------------------------------------------------
# Planner (the LLM that issues CALL / SELECT actions)
# ---------------------------------------------------------------------------
# Weights to serve with vLLM. We used Qwen3.5-397B-A17B-FP8.
PLANNER_MODEL_PATH=/path/to/Qwen3.5-397B-A17B-FP8
# Name the served model is registered under; configs/planner.yaml uses it.
PLANNER_MODEL_NAME=qwen3.5-397b
# OpenAI-compatible endpoint served by scripts/serve_planner.sh.
PLANNER_BASE_URL=http://127.0.0.1:8000/v1
PLANNER_API_KEY=token-abc123
# Tensor-parallel size and port for scripts/serve_planner.sh.
PLANNER_TP=8
PLANNER_PORT=8000
PLANNER_MAX_MODEL_LEN=262144
# Serving knobs read by scripts/serve_planner.sh.
PLANNER_GPU_MEM_UTIL=0.90
PLANNER_LOG_DIR=

# ---------------------------------------------------------------------------
# Single-step retrosynthesis model
# ---------------------------------------------------------------------------
# Endpoint the step model is served on, and the name it is registered under.
# The config reads both through ${SINGLE_STEP_BASE_URL} / ${SINGLE_STEP_MODEL};
# the defaults here match the fallbacks in configs/dianshi_direct.yaml.
SINGLE_STEP_BASE_URL=http://127.0.0.1:8001/v1
SINGLE_STEP_MODEL=qwen3-4b
SINGLE_STEP_API_KEY=token-abc123
# Serving knobs read by scripts/serve_single_step.sh.
# Leave empty until you have the checkpoint; the script names the variable.
SINGLE_STEP_MODEL_PATH=
SINGLE_STEP_PORT=8001
SINGLE_STEP_TP=1
SINGLE_STEP_MAX_MODEL_LEN=8192
SINGLE_STEP_GPU_MEM_UTIL=0.90
SINGLE_STEP_LOG_DIR=

# ---------------------------------------------------------------------------
# Template-gate assets
# ---------------------------------------------------------------------------
# rdchiral template library used by the template gate.
WANJ_RDCHIRAL_TEMPLATE_JSONL=retro_assets/template/rdchiral_res_rxn_temp_count.jsonl
# Building blocks the gate treats as purchasable. Defaults to the copy under
# dataset/ when left empty.
STARTING_MOLECULES=retro_assets/stock/emolecules_standardized.sqlite

# ---------------------------------------------------------------------------
# AOT* SCScore (template_filter.ranking: aot)
# ---------------------------------------------------------------------------
# Optional. The published 2048-bit checkpoint is vendored at
# inference/gate/weights/, so this is only needed to score with a different one.
SCSCORE_WEIGHTS=

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
# One target SMILES per line; passed as --data_file.
# Pick one of the three shipped target sets, e.g.:
TARGETS_FILE=retro_assets/targets/uspto_190_targets_smiles.txt
