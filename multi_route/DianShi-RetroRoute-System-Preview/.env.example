# Environment for the Dianshi-Retro bench (Qwen planner + DianShi direct).
#
# Copy to .env and fill in. config.yaml / configs/bench/*.yaml resolve $VAR
# and ${VAR:-default} references against these values; the repo-root .env is
# loaded automatically.

# --- planner (Qwen3.5-397B behind an OpenAI-compatible endpoint) ---
PLANNER_BASE_URL=http://127.0.0.1:8099/v1
# Hugging Face planner repo ID; vLLM downloads it on first serve.
PLANNER_MODEL_PATH=Qwen/Qwen3.5-397B-A17B-FP8
PLANNER_MODEL_NAME=qwen3.5-397b
PLANNER_PORT=8099
PLANNER_TP=8
PLANNER_MAX_MODEL_LEN=262144
PLANNER_GPU_MEM_UTIL=0.90
PLANNER_LOG_DIR=
# vLLM without --api-key accepts any non-empty value; the client omits the
# Authorization header when this is empty.
PLANNER_API_KEY=change-me

# --- single-step direct model (OpenAI-compatible /v1/chat/completions) ---
SINGLE_STEP_API_URL=http://127.0.0.1:10120/v1/chat/completions
SINGLE_STEP_API_KEY=change-me
# Local path to the DianShi direct checkpoint; serve_single_step.sh needs it.
SINGLE_STEP_MODEL_PATH=
SINGLE_STEP_MODEL=qwen3-4b
SINGLE_STEP_PORT=10120
SINGLE_STEP_TP=1
SINGLE_STEP_MAX_MODEL_LEN=8192
SINGLE_STEP_GPU_MEM_UTIL=0.90
SINGLE_STEP_LOG_DIR=

# --- template-gate assets (from DianShiGroup/DianShi-RetroRoute-Dataset) ---
DIANSHI_RDCHIRAL_TEMPLATE_JSONL=./DianShi-RetroRoute-Dataset/rxn_template/rdchiral_res_rxn_temp_count.jsonl
STARTING_MOLECULES=./DianShi-RetroRoute-Dataset/stock/emolecules_standardized.sqlite
